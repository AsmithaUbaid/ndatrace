# E05 full-context architecture (reconstruction-v2) -- bakes num_ctx=16384 into the model's
# own default, since Ollama's OpenAI-compatible /v1/chat/completions endpoint does not honor a
# per-request options.num_ctx override in the installed Ollama version (0.34.3) -- confirmed
# via direct curl, see experiments/E05_full_context/summary.md. Build with:
#   ollama create qwen2.5:7b-instruct-ctx16k -f configs/ollama/qwen2.5-7b-instruct-ctx16k.Modelfile
# Then point ModelGateway.local(model="qwen2.5:7b-instruct-ctx16k") at the resulting tag.
FROM qwen2.5:7b-instruct
PARAMETER num_ctx 16384
