# NDATrace Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file

# === LLM Provider ===
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Groq (free-tier hosted model - avoids local compute/heat) ===
# Sign up free at https://console.groq.com, generate a key under API Keys.
# Groq's catalog no longer includes a general-purpose Llama chat model
# (verified live 2026-09-23 - only llama-prompt-guard, a content
# classifier). gpt-oss-20b is what's actually available; check your
# console's model list if this changes.
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=openai/gpt-oss-20b

# === Model Configuration ===
# Production runtime model (pipeline/final_review.py reads this via
# pipeline/config.py's settings.default_model). Gemini was an earlier,
# legacy default - the shipped final product runtime
# uses GPT-5-mini with the frozen P0 prompt over the top-5 RAG context.
# FULL-context remains the benchmark quality reference, not the served path.
# See docs/architecture_decisions/INDEX.md (ADR-012).
# ADR-001 (historical) and docs/architecture_decisions/INDEX.md.
DEFAULT_MODEL=openai/gpt-5-mini
TEMPERATURE=0.0
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30

# === Embedding Model ===
EMBEDDING_MODEL=all-mpnet-base-v2

# === Retrieval Configuration ===
# DEFAULT_TOP_K matches the production runtime (pipeline/frozen_rag.py).
# CHUNK_SIZE/CHUNK_OVERLAP below are NOT read by the production chunker -
# pipeline/frozen_rag.py hardcodes 256 tokens, no overlap. These two
# variables only affect scripts/run_e06_retrieval.py's CLI defaults, kept
# for reproducing the E06 retrieval-optimisation sweep. Editing them here
# has no effect on the shipped retrieval behavior.
DEFAULT_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# === Agent Configuration ===
AGENT_MAX_STEPS=5
AGENT_MAX_TOKENS=3000
AGENT_MAX_SECONDS=30

# === Confidence / Abstention ===
CONFIDENCE_THRESHOLD=0.7

# === Paths ===
DATA_DIR=data/contractnli
RESULTS_DIR=results
LOGS_DIR=logs
CACHE_DIR=cache

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=logs/ndatrace.jsonl

# === Backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# === Database ===
DATABASE_URL=sqlite:///ndatrace.db

# === Budget Safety ===
# Local backend cumulative-spend ceiling. Choose this deliberately for your
# own account; it is not an OpenRouter account balance or a production quota.
MAX_BUDGET_USD=1.00
WARN_BUDGET_PCT=80
