# NDATrace Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file

# === LLM Provider ===
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Model Configuration ===
DEFAULT_MODEL=google/gemini-2.5-flash-lite
TEMPERATURE=0.0
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30

# === Embedding Model ===
EMBEDDING_MODEL=all-mpnet-base-v2

# === Retrieval Configuration ===
DEFAULT_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# === Agent Configuration ===
AGENT_MAX_STEPS=5
AGENT_MAX_TOKENS=3000
AGENT_MAX_SECONDS=30

# === Confidence / Abstention ===
CONFIDENCE_THRESHOLD=0.7

# === Paths ===
DATA_DIR=data/contractnli
RESULTS_DIR=results
LOGS_DIR=logs
CACHE_DIR=cache

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=logs/ndatrace.jsonl

# === Backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# === Database ===
DATABASE_URL=sqlite:///ndatrace.db

# === Budget Safety ===
# Verified remaining OpenRouter balance as of 2026-09-22 (see data/budget_plan.json)
MAX_BUDGET_USD=6.99
WARN_BUDGET_PCT=80
