# NDATrace Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file
#
# This file has two parts, clearly labelled:
#   PART 1 - ACTIVE RUNTIME: every value here is actually read by the live
#   backend/pipeline (pipeline/config.py's Settings class) on the frozen,
#   shipped architecture (BM25 -> rerank -> top-5 -> GPT-5-mini + P0, see
#   docs/architecture_decisions/INDEX.md ADR-012). Changing these changes
#   real product behavior.
#   PART 2 - EXPERIMENTAL / HISTORICAL (NOT ACTIVE): every value here is
#   verified NOT read by the production backend or pipeline/final_review.py.
#   They exist only so specific past experiments (named per variable) stay
#   reproducible, or so one-off CLI scripts have a default. Changing these
#   has ZERO effect on the deployed product - do not mistake them for live
#   configuration.

# =============================================================================
# PART 1 - ACTIVE RUNTIME (read by the live backend / pipeline)
# =============================================================================

# === LLM Provider (required for any live review call) ===
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Model ===
# pipeline/config.py's settings.default_model is read by
# pipeline/final_review.py - this is the single source of truth for which
# model the live product calls. Gemini was an earlier, legacy default
# (docs/decisions.md ADR-001, historical); the frozen final architecture
# (docs/architecture_decisions/INDEX.md ADR-012) uses GPT-5-mini + the
# frozen P0 prompt over the top-5 RAG context.
DEFAULT_MODEL=openai/gpt-5-mini
TEMPERATURE=0.0
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30

# === Paths ===
DATA_DIR=data/contractnli
RESULTS_DIR=results
LOGS_DIR=logs
CACHE_DIR=cache

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=logs/ndatrace.jsonl

# === Backend server ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# === Database ===
DATABASE_URL=sqlite:///ndatrace.db

# === Budget safety (pipeline/cost_guard.py enforces this on every live call) ===
# Local backend cumulative-spend ceiling. Choose this deliberately for your
# own account; it is not an OpenRouter account balance or a production quota.
MAX_BUDGET_USD=1.00
WARN_BUDGET_PCT=80

# =============================================================================
# PART 2 - EXPERIMENTAL / HISTORICAL ONLY (verified NOT read by the live
# backend or pipeline/final_review.py - safe to ignore unless you are
# reproducing the specific experiment named below)
# =============================================================================

# --- Groq (used only by the historical local-vs-hosted comparison arm, C02
# / docs/experiment_registry.md's E08B-adjacent runs, via
# pipeline/model_gateway.py's Groq branch - never invoked by the live
# /api/review or /review routes, which always call OpenRouter + DEFAULT_MODEL
# above). Sign up free at https://console.groq.com if you need to rerun that
# comparison. Groq's catalog no longer includes a general-purpose Llama chat
# model (verified live 2026-09-23 - only llama-prompt-guard, a content
# classifier); gpt-oss-20b is what's actually available. ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=openai/gpt-oss-20b

# --- Dense embedding model (pipeline/embedder.py) - used only by the
# historical dense-vs-BM25 retrieval comparison (E06), via
# scripts/run_e06_*.py. The frozen production retriever
# (pipeline/frozen_rag.py) is BM25-only and never loads an embedding model. ---
EMBEDDING_MODEL=all-mpnet-base-v2

# --- Retrieval CLI defaults (scripts/run_e06_retrieval.py only). The
# production retriever hardcodes TOP_K=5, CHUNK_SIZE=256, no overlap
# directly in pipeline/frozen_rag.py and never reads these three values -
# editing them here has no effect on the shipped retrieval behavior. ---
DEFAULT_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- Selective agent (E09-E11: tested and explicitly REJECTED, see
# docs/experiment_registry.md's E11 entry - zero net benefit, zero tool
# calls on every triggered case). pipeline/final_review.py never reads
# these; kept only so scripts/run_e21_owasp.py and pipeline/agent_v2.py's
# own saved experiments stay reproducible. The shipped product has no agent. ---
AGENT_MAX_STEPS=5
AGENT_MAX_TOKENS=3000
AGENT_MAX_SECONDS=30

# --- Confidence / abstention gate (E15: tested and explicitly REJECTED -
# no policy reached both an acceptable review workload and an acceptable
# residual-error rate, see docs/experiment_registry.md's E15 entry).
# Nothing in the live backend reads this. The shipped product has no
# automatic confidence gate - every result goes to a human reviewer. ---
CONFIDENCE_THRESHOLD=0.7
